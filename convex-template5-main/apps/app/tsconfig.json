{
  "extends": "../../tooling/typescript/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@v1/ui/*": ["../../packages/ui/src/*"],
      "@v1/ui": ["../../packages/ui/src"],
      "@v1/backend/*": ["../../packages/backend/*"],
      "@v1/backend": ["../../packages/backend"],
      "@v1/analytics/*": ["../../packages/analytics/src/*"],
      "@v1/analytics": ["../../packages/analytics/src"]
    },
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "../../bun-test.d.ts",
    "next-env.d.ts",
    "next.config.js",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "tailwind.config.ts",
    "src/env.mjs"
  ],
  "exclude": ["node_modules"]
}
